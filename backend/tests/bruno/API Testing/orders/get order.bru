meta {
  name: get order
  type: http
  seq: 5
}

get {
  url: http://{{host}}:{{port}}/api/orders/{{orderId}}
  body: none
  auth: none
}

headers {
  X-Attendee-Session-ID: {{attendeeSessionId}}
}

tests {
  test("get order returns 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body._id).to.equal(bru.getEnvVar("orderId"));
    expect(res.body.items).to.be.an("array");
  });
}

settings {
  encodeUrl: true
}
