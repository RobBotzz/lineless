meta {
  name: list orders for stand
  type: http
  seq: 4
}

get {
  url: http://{{host}}:{{port}}/api/stands/{{standId}}/orders
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

tests {
  test("list orders returns 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

settings {
  encodeUrl: true
}
