meta {
  name: stock after replay
  type: http
  seq: 4
}

get {
  url: http://{{host}}:{{port}}/api/products/{{productId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

tests {
  test("idempotent replay does not reserve stock twice", function () {
    expect(res.status).to.equal(200);
    expect(res.body.productStock).to.equal(Number(bru.getEnvVar("stockAfterInitialOrder")));
  });
}

settings {
  encodeUrl: true
}
