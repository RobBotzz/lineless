meta {
  name: get order status
  type: http
  seq: 2
}

get {
  url: http://{{host}}:{{port}}/api/orders/status?pickupCode={{pickupCode}}
  body: none
  auth: none
}

params:query {
  pickupCode: {{pickupCode}}
}

tests {
  test("get order status by pickupCode returns 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body.pickupCode).to.equal(bru.getEnvVar("pickupCode"));
    expect(res.body.items).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
