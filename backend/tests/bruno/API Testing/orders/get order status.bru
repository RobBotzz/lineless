meta {
  name: get order status
  type: http
  seq: 2
}

get {
  url: http://{{host}}:{{port}}/api/orders/status?authCode={{authCode}}
  body: none
  auth: none
}

tests {
  test("get order status by authCode returns 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body.authCode).to.equal(bru.getEnvVar("authCode"));
    expect(res.body.items).to.be.an("array");
  });
}

settings {
  encodeUrl: true
}
