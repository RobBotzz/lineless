meta {
  name: create order
  type: http
  seq: 1
}

post {
  url: http://{{host}}:{{port}}/api/orders
  body: json
  auth: none
}

headers {
  X-Attendee-Session-ID: {{attendeeSessionId}}
}

body:json {
  {
    "eventId": "{{eventId}}",
    "requestId": "{{$randomUUID}}",
    "items": [
      {
        "productId": "{{productId}}",
        "customerComment": "No ice please"
      },
      {
        "productId": "{{productId}}"
      }
    ]
  }
}

script:post-response {
  if (res.status === 201 && res.body.order?._id) {
    bru.setEnvVar("orderId", res.body.order._id);
    bru.setEnvVar("orderRequestId", res.body.order.requestId);
    bru.setEnvVar("pickupCode", res.body.order.pickupCode);
    if (res.body.order.items && res.body.order.items.length > 0) {
      bru.setEnvVar("itemId", res.body.order.items[0]._id);
    }
  }
}

tests {
  test("create order returns 201", function () {
    expect(res.status).to.equal(201);
    expect(res.body.order._id).to.be.a("string").and.not.empty;
    expect(res.body.order.pickupCode).to.be.a("string").and.not.empty;
    expect(res.body.order.orderNumber).to.be.a("string").and.not.empty;
    expect(res.body.order.items).to.be.an("array").and.not.empty;
    expect(res.body.order.items.every(item => item.inventoryState === "RESERVED")).to.equal(true);
  });
}

settings {
  encodeUrl: true
}
