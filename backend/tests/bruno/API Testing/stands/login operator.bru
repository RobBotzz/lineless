meta {
  name: login operator
  type: http
  seq: 6
}

post {
  url: http://{{host}}:{{port}}/api/stands/login
  body: json
  auth: none
}

body:json {
  {
    "standId": "{{standId}}",
    "accessPassword": "secret123"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setEnvVar("operatorToken", res.body.token);
  }
}

tests {
  test("operator login returns stand-scoped token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string").and.not.empty;
    expect(res.body.standId).to.equal(bru.getEnvVar("standId"));
  });
}

settings {
  encodeUrl: true
}
