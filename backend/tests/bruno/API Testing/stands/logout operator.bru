meta {
  name: logout operator
  type: http
  seq: 12
}

post {
  url: http://{{host}}:{{port}}/api/stands/{{standId}}/logout
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{operatorRefreshToken}}"
  }
}

tests {
  test("operator logout returns 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
