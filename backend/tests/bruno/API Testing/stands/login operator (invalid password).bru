meta {
  name: login operator (invalid password)
  type: http
  seq: 7
}

post {
  url: http://{{host}}:{{port}}/api/stands/{{standId}}/login
  body: json
  auth: none
}

body:json {
  {
    "operatorAccessKey": "{{operatorAccessKey}}",
    "accessPassword": "wrong-password"
  }
}

tests {
  test("valid link key but wrong password is rejected", function () {
    expect(res.status).to.equal(401);
  });
}

settings {
  encodeUrl: true
}
