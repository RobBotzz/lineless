meta {
  name: login operator (invalid password)
  type: http
  seq: 7
}

post {
  url: http://{{host}}:{{port}}/api/stands/login
  body: json
  auth: none
}

body:json {
  {
    "standId": "{{standId}}",
    "accessPassword": "wrong-password"
  }
}

tests {
  test("invalid operator credentials are rejected", function () {
    expect(res.status).to.equal(401);
  });
}

settings {
  encodeUrl: true
}
