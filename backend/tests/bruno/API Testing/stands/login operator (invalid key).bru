meta {
  name: login operator (invalid key)
  type: http
  seq: 8
}

post {
  url: http://{{host}}:{{port}}/api/stands/login
  body: json
  auth: none
}

body:json {
  {
    "standId": "{{standId}}",
    "operatorAccessKey": "definitely-not-the-real-key",
    "accessPassword": "secret123"
  }
}

tests {
  test("a wrong event link key is rejected even with the correct password", function () {
    expect(res.status).to.equal(401);
  });
}

settings {
  encodeUrl: true
}
