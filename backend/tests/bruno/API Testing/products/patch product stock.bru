meta {
  name: patch product stock
  type: http
  seq: 5
}

patch {
  url: http://{{host}}:{{port}}/api/products/{{productId}}/stock
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

body:json {
  {
    "productStock": 80,
    "expectedProductStock": 100
  }
}

tests {
  test("stock is updated with compare-and-set", function () {
    expect(res.status).to.equal(200);
    expect(res.body.productStock).to.equal(80);
  });
}

settings {
  encodeUrl: true
}
