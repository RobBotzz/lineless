meta {
  name: create product
  type: http
  seq: 1
}

post {
  url: http://{{host}}:{{port}}/api/stands/{{standId}}/products
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

body:json {
  {
    "productName": "Cola",
    "productDescription": "Refreshing soft drink",
    "priceIncludingTax": 250,
    "taxRate": 1900,
    "instantProduct": false,
    "stockMode": "TRACKED",
    "productStock": 100
  }
}

settings {
  encodeUrl: true
}
