meta {
  name: logout
  type: http
  seq: 5
}

post {
  url: http://{{host}}:{{port}}/api/account/logout
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{organizerRefreshToken}}"
  }
}

tests {
  test("logout returns 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
