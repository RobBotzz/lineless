meta {
  name: forgot-password
  type: http
  seq: 3
}

post {
  url: http://{{host}}:{{port}}/api/account/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "torben@test.de"
  }
}

tests {
  test("forgot-password responds 200 with a generic message", function () {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
