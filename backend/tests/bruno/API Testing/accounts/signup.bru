meta {
  name: signup
  type: http
  seq: 1
}

post {
  url: http://{{host}}:{{port}}/api/account/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "torben@test.de",
    "password": "1234567a",
    "firstName": "Max",
    "lastName": "Mustermann"
  }
}

script:post-response {
  if (res.status === 201 && res.body.token) {
    bru.setEnvVar("organizerToken", res.body.token);
    bru.setEnvVar("organizerRefreshToken", res.body.refreshToken);
  }
}

tests {
  test("signup either creates organizer or reports existing account", function () {
    expect([201, 409]).to.include(res.status);
  });
  if (res.status === 201) {
    test("signup returns organizer token", function () {
      expect(res.body.token).to.be.a("string").and.not.empty;
    });
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
