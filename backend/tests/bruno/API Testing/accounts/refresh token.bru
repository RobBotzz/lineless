meta {
  name: refresh token
  type: http
  seq: 4
}

post {
  url: http://{{host}}:{{port}}/api/account/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{organizerRefreshToken}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.refreshToken) {
    bru.setEnvVar("organizerToken", res.body.token);
    bru.setEnvVar("organizerRefreshToken", res.body.refreshToken);
  }
}

tests {
  test("refresh returns a new access token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string").and.not.empty;
  });
  test("refresh rotates the refresh token", function () {
    expect(res.body.refreshToken).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
