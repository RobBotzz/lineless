meta {
  name: create attendee session (invalid event)
  type: http
  seq: 2
}

post {
  url: http://{{host}}:{{port}}/api/sessions/create
  body: json
  auth: none
}

body:json {
  {
    "eventId": "00000000-0000-4000-8000-000000000000"
  }
}

tests {
  test("rejects unknown event", function () {
    expect(res.status).to.equal(404);
  });
}

settings {
  encodeUrl: true
}
