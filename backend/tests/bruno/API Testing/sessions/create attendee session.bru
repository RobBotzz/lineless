meta {
  name: create attendee session
  type: http
  seq: 1
}

post {
  url: http://{{host}}:{{port}}/api/sessions/create
  body: json
  auth: none
}

body:json {
  {
    "eventId": "{{eventId}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body.sessionId) {
    bru.setEnvVar("attendeeSessionId", res.body.sessionId);
  }
}

tests {
  test("creates attendee session", function () {
    expect(res.status).to.equal(201);
    expect(res.body.sessionId).to.be.a("string").and.not.empty;
    expect(res.body.eventId).to.equal(bru.getEnvVar("eventId"));
    expect(res.body.expiresAt).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
