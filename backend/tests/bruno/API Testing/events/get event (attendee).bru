meta {
  name: get event (attendee)
  type: http
  seq: 2
}

get {
  url: http://{{host}}:{{port}}/api/events/{{eventId}}
  body: none
  auth: none
}

headers {
  X-Attendee-Session-ID: {{attendeeSessionId}}
}

tests {
  test("attendee can read event", function () {
    expect(res.status).to.equal(200);
  });
  test("event exposes location", function () {
    expect(res.body).to.have.property("location");
  });
}

settings {
  encodeUrl: true
}
