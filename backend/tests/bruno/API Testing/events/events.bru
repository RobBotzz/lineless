meta {
  name: events
  type: http
  seq: 1
}

post {
  url: http://{{host}}:{{port}}/api/events
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

body:json {
  {
    "name": "Sommerfest",
    "plannedDate": "2026-05-30T12:22:02.202Z",
      "ratingsEnabled": false,
      "cashierEnabled": true,
      "offlineOrdersEnabled": true,
      "branding": {
        "primaryColor": "#FF8800",
        "secondaryColor": "#1E1E1E",
        "logoUrl": "https://example.com/logo.png"
      }
    }
}

script:post-response {
  if (res.status === 201 && res.body._id) {
    bru.setEnvVar("eventId", res.body._id);
  }
}

settings {
  encodeUrl: true
}
