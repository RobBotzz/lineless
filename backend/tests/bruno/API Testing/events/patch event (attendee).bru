meta {
  name: patch event (attendee)
  type: http
  seq: 4
}

patch {
  url: http://{{host}}:{{port}}/api/events/{{eventId}}
  body: json
  auth: none
}

headers {
  X-Attendee-Session-ID: {{attendeeSessionId}}
}

body:json {
  {
    "location": {
      "locationName": "Attendee should not set this",
      "xCoordinate": 0,
      "yCoordinate": 0
    }
  }
}

tests {
  test("attendee cannot set location", function () {
    expect(res.status).to.equal(401);
  });
}

settings {
  encodeUrl: true
}
