meta {
  name: patch event
  type: http
  seq: 1
}

patch {
  url: http://{{host}}:{{port}}/api/events/{{eventId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

body:json {
  {
      "name": "Winterfest",
      "location": {
        "locationName": "Innenhof",
        "xCoordinate": 48.1374,
        "yCoordinate": 11.5755
      },
      "plannedDate": "2026-05-30T12:22:02.202Z",
      "ratingsEnabled": false,
      "cashierEnabled": true,
      "offlineOrdersEnabled": true,
      "branding": {
        "primaryColor": "#FF8800",
        "secondaryColor": "#1E1E1E",
        "logoUrl": "https://example.com/logo.png"
      }
    }
}

settings {
  encodeUrl: true
}
