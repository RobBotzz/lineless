meta {
  name: 09 submit order under limit
  type: http
  seq: 9
}

post {
  url: http://{{host}}:{{port}}/api/orders
  body: json
  auth: none
}

headers {
  X-Attendee-Session-ID: {{paySessionId}}
}

body:json {
  {
    "eventId": "{{eventId}}",
    "tabId": "{{tabId}}",
    "items": [
      { "productId": "{{productId}}" }
    ]
  }
}

script:post-response {
  if (res.status === 201 && res.body.order) {
    const order = res.body.order;
    const total = order.items.reduce(
      (sum, i) => sum + i.priceIncludingTaxAtPurchase,
      0
    );
    bru.setVar("orderId", order._id);
    bru.setVar("itemId", order.items[0]._id);
    bru.setVar("consumedExpected", total);
  }
}

tests {
  test("order within hold is accepted and released", function () {
    expect(res.status).to.equal(201);
    expect(res.body.order).to.be.an("object");
    expect(res.body.order.items).to.be.an("array").and.not.empty;
    // Baseline is authorized and the order fits the 5000 hold => items start now.
    expect(res.body.order.items[0].startedAt).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
