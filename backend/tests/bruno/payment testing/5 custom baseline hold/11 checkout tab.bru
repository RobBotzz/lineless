meta {
  name: 11 checkout tab
  type: http
  seq: 11
}

post {
  url: http://{{host}}:{{port}}/api/events/{{eventId}}/tabs/checkout
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

tests {
  // Captures the real Stripe PaymentIntent for only the ready item total; the
  // captured amount is far below the 5000 hold. The captured PaymentIntent is
  // now visible in the Stripe dashboard.
  test("organizer checkout captures ready tab and marks it PAID", function () {
    expect(res.status).to.equal(200);
    const result = res.body.results.find(r => r.tabId === bru.getVar("tabId"));
    expect(result.status).to.equal("PAID");
    expect(result.capturedTotal).to.equal(Number(bru.getVar("consumedExpected")));
    expect(result.capturedTotal).to.be.below(5000);
  });
}

settings {
  encodeUrl: true
}
