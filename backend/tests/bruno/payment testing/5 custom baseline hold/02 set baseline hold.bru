meta {
  name: 02 set baseline hold
  type: http
  seq: 2
}

patch {
  url: http://{{host}}:{{port}}/api/events/{{eventId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

body:json {
  {
    "baselineHoldCents": 5000
  }
}

tests {
  test("event baseline hold updated to 5000", function () {
    expect(res.status).to.equal(200);
    expect(res.body.baselineHoldCents).to.equal(5000);
  });
}

settings {
  encodeUrl: true
}
