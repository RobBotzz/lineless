meta {
  name: 12 reset baseline hold
  type: http
  seq: 12
}

patch {
  url: http://{{host}}:{{port}}/api/events/{{eventId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

body:json {
  {
    "baselineHoldCents": 1000
  }
}

tests {
  test("event baseline hold reset to 1000 default", function () {
    expect(res.status).to.equal(200);
    expect(res.body.baselineHoldCents).to.equal(1000);
  });
}

settings {
  encodeUrl: true
}
