meta {
  name: 09 ready item
  type: http
  seq: 9
}

post {
  url: http://{{host}}:{{port}}/api/orders/{{orderId}}/items/{{itemId}}/ready
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{operatorToken}}
}

tests {
  test("item is ready", function () {
    expect(res.status).to.equal(200);
    const item = res.body.items.find(i => i._id === bru.getVar("itemId"));
    expect(item.readyAt).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
