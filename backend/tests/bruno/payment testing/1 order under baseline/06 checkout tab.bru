meta {
  name: 10 organizer checkout tabs
  type: http
  seq: 10
}

post {
  url: http://{{host}}:{{port}}/api/events/{{eventId}}/tabs/checkout
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

tests {
  test("organizer checkout captures ready tab and marks it PAID", function () {
    expect(res.status).to.equal(200);
    const result = res.body.results.find(r => r.tabId === bru.getVar("tabId"));
    expect(result.status).to.equal("PAID");
    expect(result.capturedTotal).to.equal(Number(bru.getVar("consumedExpected")));
    expect(result.capturedTotal).to.be.below(1000);
  });
}

settings {
  encodeUrl: true
}
