meta {
  name: 04 create attendee session
  type: http
  seq: 4
}

post {
  url: http://{{host}}:{{port}}/api/sessions/create
  body: json
  auth: none
}

body:json {
  {
    "eventId": "{{eventId}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body.sessionId) {
    bru.setVar("paySessionId", res.body.sessionId);
  }
}

tests {
  test("attendee session created", function () {
    expect(res.status).to.equal(201);
    expect(res.body.sessionId).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
