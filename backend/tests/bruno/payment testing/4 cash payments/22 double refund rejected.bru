meta {
  name: 22 double refund rejected
  type: http
  seq: 22
}

post {
  url: http://{{host}}:{{port}}/api/orders/{{refundOrderId}}/refund
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

body:json {
  {
    "itemIds": ["{{refundItemId}}"]
  }
}

tests {
  test("refunding an already-refunded item is rejected", function () {
    expect(res.status).to.equal(409);
  });
}

settings {
  encodeUrl: true
}
