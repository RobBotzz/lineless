meta {
  name: 11 refund exceeding total rejected
  type: http
  seq: 11
}

post {
  url: http://{{host}}:{{port}}/api/cash-payments/{{cashPaymentId}}/refund
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

body:json {
  {
    "amountCents": 99999999
  }
}

tests {
  test("over-refund is rejected", function () {
    expect(res.status).to.equal(422);
    expect(res.body.error).to.equal("Refund amount exceeds the order total");
  });
}

settings {
  encodeUrl: true
}
