meta {
  name: 03 find cashier stand
  type: http
  seq: 3
}

get {
  url: http://{{host}}:{{port}}/api/events/{{eventId}}/stands
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body)) {
    const cashier = res.body.find(s => s.standType === "CASHIER");
    if (cashier) {
      bru.setVar("cashierStandId", cashier._id);
    }
  }
}

tests {
  test("event has a cashier stand", function () {
    expect(res.status).to.equal(200);
    const cashier = res.body.find(s => s.standType === "CASHIER");
    expect(cashier).to.be.an("object");
    expect(cashier._id).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
