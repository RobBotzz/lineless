meta {
  name: 04 login cashier
  type: http
  seq: 4
}

post {
  url: http://{{host}}:{{port}}/api/stands/{{cashierStandId}}/login
  body: json
  auth: none
}

body:json {
  {
    "operatorAccessKey": "{{operatorAccessKey}}",
    "accessPassword": "{{operatorPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setVar("cashierToken", res.body.token);
  }
}

tests {
  test("cashier login returns stand-scoped token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string").and.not.empty;
    expect(res.body.standId).to.equal(bru.getVar("cashierStandId"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
