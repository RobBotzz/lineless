meta {
  name: 10 refund cash payment
  type: http
  seq: 10
}

post {
  url: http://{{host}}:{{port}}/api/cash-payments/{{cashPaymentId}}/refund
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

body:json {
  {
    "amountCents": 1
  }
}

tests {
  test("cash refund is recorded", function () {
    expect(res.status).to.equal(201);
    expect(res.body._id).to.be.a("string").and.not.empty;
    expect(res.body.amountCents).to.equal(1);
  });
}

settings {
  encodeUrl: true
}
