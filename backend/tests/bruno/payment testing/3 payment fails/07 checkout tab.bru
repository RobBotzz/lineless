meta {
  name: 07 checkout tab
  type: http
  seq: 7
}

post {
  url: http://{{host}}:{{port}}/api/tabs/{{tabId}}/checkout
  body: none
  auth: none
}

headers {
  X-Attendee-Session-ID: {{paySessionId}}
}

tests {
  // Only the baseline (1000) was authorized; the overage failed, so checkout
  // captures exactly the baseline.
  test("checkout captures baseline only", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("PAID");
    expect(res.body.capturedTotal).to.equal(1000);
  });
}

settings {
  encodeUrl: true
}
