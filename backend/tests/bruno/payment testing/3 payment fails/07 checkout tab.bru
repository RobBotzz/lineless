meta {
  name: 07 checkout tab
  type: http
  seq: 7
}

post {
  url: http://{{host}}:{{port}}/api/tabs/{{tabId}}/checkout
  body: none
  auth: none
}

headers {
  X-Attendee-Session-ID: {{paySessionId}}
}

tests {
  // The overage failed, so the authorized holds do not cover the tab total.
  // Checkout must not mark the tab paid.
  test("checkout is rejected when holds do not cover the tab", function () {
    expect(res.status).to.equal(409);
    expect(res.body.error).to.equal("Authorized holds do not cover the tab total");
  });
}

settings {
  encodeUrl: true
}
