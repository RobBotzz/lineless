meta {
  name: 15 submit order over limit 2
  type: http
  seq: 15
}

post {
  url: http://{{host}}:{{port}}/api/orders
  body: json
  auth: none
}

headers {
  X-Attendee-Session-ID: {{paySessionId}}
}

body:json {
  {
    "standId": "{{standId}}",
    "tabId": "{{tabId2}}",
    "items": [
      { "productId": "{{productId}}", "quantity": 50 }
    ]
  }
}

script:post-response {
  if (res.status === 402 && res.body.clientSecret) {
    bru.setVar("overagePI2", res.body.clientSecret.split("_secret_")[0]);
  }
}

tests {
  test("order exceeding hold returns 402", function () {
    expect(res.status).to.equal(402);
    expect(res.body.clientSecret).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
