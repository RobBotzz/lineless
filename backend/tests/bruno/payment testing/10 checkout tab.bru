meta {
  name: 10 checkout tab
  type: http
  seq: 10
}

post {
  url: http://{{host}}:{{port}}/api/tabs/{{tabId}}/checkout
  body: none
  auth: none
}

headers {
  X-Attendee-Session-ID: {{paySessionId}}
}

tests {
  test("checkout captures holds and marks tab PAID", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("PAID");
    expect(res.body.capturedTotal).to.be.a("number");
    expect(res.body.capturedTotal).to.be.above(0);
  });
}

settings {
  encodeUrl: true
}
