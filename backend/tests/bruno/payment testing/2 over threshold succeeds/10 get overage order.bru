meta {
  name: 13 get overage order
  type: http
  seq: 13
}

get {
  url: http://{{host}}:{{port}}/api/orders/{{overOrderId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

script:post-response {
  if (res.status === 200 && res.body.items) {
    res.body.items.forEach(function(item, i) {
      bru.setVar("overageItemId" + i, item._id);
    });
  }
}

tests {
  test("overage order has 6 items all in PREPARING state", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.have.length(6);
    res.body.items.forEach(function(item) {
      expect(item.startedAt).to.be.a("string").and.not.empty;
      expect(item.readyAt).to.equal(null);
      expect(item.fulfilledAt).to.equal(null);
    });
  });
}

settings {
  encodeUrl: true
}
