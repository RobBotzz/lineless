meta {
  name: 17 ready overage item 2
  type: http
  seq: 17
}

post {
  url: http://{{host}}:{{port}}/api/orders/{{overOrderId}}/items/{{overageItemId2}}/ready
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{operatorToken}}
}

tests {
  test("overage item 2 is ready", function () {
    expect(res.status).to.equal(200);
    const item = res.body.items.find(i => i._id === bru.getVar("overageItemId2"));
    expect(item.readyAt).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
