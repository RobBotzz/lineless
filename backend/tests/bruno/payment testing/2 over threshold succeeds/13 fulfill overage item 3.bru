meta {
  name: 24 fulfill overage item 3
  type: http
  seq: 24
}

post {
  url: http://{{host}}:{{port}}/api/orders/{{overOrderId}}/items/{{overageItemId3}}/fulfill
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{operatorToken}}
}

tests {
  test("overage item 3 is fulfilled", function () {
    expect(res.status).to.equal(200);
    const item = res.body.items.find(i => i._id === bru.getVar("overageItemId3"));
    expect(item.fulfilledAt).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
