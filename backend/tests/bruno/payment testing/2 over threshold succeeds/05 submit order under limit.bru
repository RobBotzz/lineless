meta {
  name: 08 submit order under limit
  type: http
  seq: 8
}

post {
  url: http://{{host}}:{{port}}/api/orders
  body: json
  auth: none
}

headers {
  X-Attendee-Session-ID: {{paySessionId}}
}

body:json {
  {
    "eventId": "{{eventId}}",
    "requestId": "{{$randomUUID}}",
    "tabId": "{{tabId}}",
    "items": [
      { "productId": "{{productId}}" }
    ]
  }
}

script:post-response {
  if (res.status === 201 && res.body.order) {
    const order = res.body.order;
    bru.setVar("firstOrderId", order._id);
    bru.setVar("firstItemId", order.items[0]._id);
  }
}

tests {
  test("first order within hold is accepted and released", function () {
    expect(res.status).to.equal(201);
    expect(res.body.order.items[0].startedAt).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
