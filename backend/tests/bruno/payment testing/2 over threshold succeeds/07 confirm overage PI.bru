meta {
  name: 11 confirm overage PI
  type: http
  seq: 11
}

post {
  url: https://api.stripe.com/v1/payment_intents/{{overagePI}}/confirm?payment_method=pm_card_visa&return_url=https://example.com/return
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{stripeSecretKey}}
}

tests {
  test("overage hold is now capturable", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("requires_capture");
  });
}

settings {
  encodeUrl: true
}
