meta {
  name: 15 ready overage item 0
  type: http
  seq: 15
}

post {
  url: http://{{host}}:{{port}}/api/orders/{{overOrderId}}/items/{{overageItemId0}}/ready
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{operatorToken}}
}

tests {
  test("overage item 0 is ready", function () {
    expect(res.status).to.equal(200);
    const item = res.body.items.find(i => i._id === bru.getVar("overageItemId0"));
    expect(item.readyAt).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
