script:post-response {
  // 402 returns only { clientSecret }; derive the overage PaymentIntent id
  // (format: pi_xxx_secret_yyy -> pi_xxx).
  if (res.status === 402 && res.body.clientSecret) {
    bru.setVar("overagePI", res.body.clientSecret.split("_secret_")[0]);
  }
}

tests {
  test("order exceeding hold returns 402 with a client secret", function () {
    expect(res.status).to.equal(402);
    expect(res.body.clientSecret).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
