meta {
  name: 26 fulfill overage item 5
  type: http
  seq: 26
}

post {
  url: http://{{host}}:{{port}}/api/orders/{{overOrderId}}/items/{{overageItemId5}}/fulfill
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{operatorToken}}
}

tests {
  test("overage item 5 is fulfilled", function () {
    expect(res.status).to.equal(200);
    const item = res.body.items.find(i => i._id === bru.getVar("overageItemId5"));
    expect(item.fulfilledAt).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
