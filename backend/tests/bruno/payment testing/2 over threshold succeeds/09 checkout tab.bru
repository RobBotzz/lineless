meta {
  name: 13 organizer checkout skips unready overage
  type: http
  seq: 13
}

post {
  url: http://{{host}}:{{port}}/api/events/{{eventId}}/tabs/checkout
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

tests {
  test("organizer checkout skips tab with authorized but unready overage items", function () {
    expect(res.status).to.equal(200);
    const result = res.body.results.find(r => r.tabId === bru.getVar("tabId"));
    expect(result.status).to.equal("SKIPPED");
    expect(result.reason).to.equal("Tab has non-cancelled items that are not ready");
  });
}

settings {
  encodeUrl: true
}
