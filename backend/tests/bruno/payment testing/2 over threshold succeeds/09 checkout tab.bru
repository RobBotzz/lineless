meta {
  name: 09 checkout tab
  type: http
  seq: 9
}

post {
  url: http://{{host}}:{{port}}/api/tabs/{{tabId}}/checkout
  body: none
  auth: none
}

headers {
  X-Attendee-Session-ID: {{paySessionId}}
}

tests {
  // Baseline + overage were both authorized, so the captured total exceeds the
  // 1000-cent baseline.
  test("checkout captures baseline + overage and marks tab PAID", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("PAID");
    expect(res.body.capturedTotal).to.be.a("number");
    expect(res.body.capturedTotal).to.be.above(1000);
  });
}

settings {
  encodeUrl: true
}
