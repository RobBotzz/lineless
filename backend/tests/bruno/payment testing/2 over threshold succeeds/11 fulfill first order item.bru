meta {
  name: 14 fulfill first order item
  type: http
  seq: 14
}

post {
  url: http://{{host}}:{{port}}/api/orders/{{firstOrderId}}/items/{{firstItemId}}/fulfill
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{operatorToken}}
}

tests {
  test("first order item is fulfilled", function () {
    expect(res.status).to.equal(200);
    const item = res.body.items.find(i => i._id === bru.getVar("firstItemId"));
    expect(item.fulfilledAt).to.be.a("string").and.not.empty;
  });
}

settings {
  encodeUrl: true
}
