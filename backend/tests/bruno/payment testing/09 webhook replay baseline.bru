meta {
  name: 09 webhook replay baseline
  type: http
  seq: 9
}

post {
  url: http://{{host}}:{{port}}/webhooks/stripe
  body: json
  auth: none
}

body:json {
  {
    "id": "evt_auth_baseline_{{baselinePI}}",
    "type": "payment_intent.amount_capturable_updated",
    "data": {
      "object": {
        "id": "{{baselinePI}}"
      }
    }
  }
}

tests {
  // Same event id as request 04: the processed-events guard makes this a no-op
  // but it must still acknowledge with 200 so Stripe stops retrying.
  test("duplicate event is acknowledged (idempotent)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.received).to.equal(true);
  });
}

settings {
  encodeUrl: true
}
